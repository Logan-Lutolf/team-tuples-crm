}

enum ProgramType {
  STORIES_OF_OUR_NEIGHBORS
  MEMORY_OF_NATIONS_THEATRE
  STORY_ON
  SCHOOL_NETWORK // Seminars
  EDUCATION_DEVELOPMENT
  WORKSHOPS
}

enum RelationshipTypes {
  POOR
  AVERAGE
  EXCELLENT
}

enum Role {
  ADMIN
  WORKSHOPS_COORDINATOR
  SCHOOL_NETWORK_COORDINATOR
  STORIES_OF_OUR_NEIGHBORS_COORDINATOR
  VETERANS_DAY_COORDINATOR
  NEWSLETTER_COORDINATOR
  BRANCH_DIRECTOR
  HEAD_OF_EDUCATION
  PROJECT_MANAGER
  COORDINATOR
  DEVELOPMENT_LEAD
  PRODUCTION
  STUDIO_LEAD
  LECTURER
  METHODOLOGY_LEAD
}

enum ProgramStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContactRole {
  TEACHER
  PRINCIPAL
  SCHOOL_COORDINATOR
  STUDENT

  HISTORIAN

  GOVERNMENT_OFFICIAL
  DONOR
  SPONSOR

  PARTNER
  VOLUNTEER
  OTHER
}

enum CommunicationMode {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO_CALL
  MESSAGE
  OTHER
}

enum OrganizationTypes {
  PRIMARY_SCHOOL
  SECONDARY_SCHOOL
  THEATRE
  CULTURAL
}

