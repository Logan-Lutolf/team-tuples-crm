  KARLOVARSKÝ
  ÚSTECKÝ
  LIBERECKÝ
  KRÁLOVÉHRADECKÝ
  PARDUBICKÝ
  JIHOMORAVSKÝ
  OLOMOUCKÝ
  ZLÍNSKÝ
  MORAVSKOSLEZSKÝ
  JIHLAVA
}

enum BranchTypes {
  SEVERNÍ_ČECHY
  VÝCHODNÍ_ČECHY
  STŘEDNÍ_MORAVA
  PLZEŇSKÝ_KRAJ
  JIŽNÍ_MORAVA
  JIŽNÍ_ČECHY
  KARLOVARSKÝ_KRAJ
  MORAVSKOSLEZSKÝ_KRAJ
