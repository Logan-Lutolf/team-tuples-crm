// use prisma-8

//---------------------------TYPES AND ENUMS---------------------------//
type Address {
  street  String
  city    String
  country String
  zipCode String
}

enum Region {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
  ELEVEN
  TWELVE
  THIRTEEN
  FOURTEEN
}

enum Branches {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
}

enum SchoolType {
  PRIMARY
  SECONDARY
  UNDERGRADUATE
  GRADUATE
  POSTGRADUATE
}

enum RelationshipType {
  POOR
  AVERAGE
  EXCELLENT
}

enum Role {
  ADMIN
  WORKSHOPS_COORDINATOR
  SCHOOL_NETWORK_COORDINATOR
  STORIES_OF_OUR_NEIGHBORS_COORDINATOR
  VETERANS_DAY_COORDINATOR
  NEWSLETTER_COORDINATOR
}

//---------------------------MODELS---------------------------//
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  Numeric
  phone     String?
  address   Address?
  region   Region?

  is_online  Boolean  @default(false)
  role      Role 

  schools SchoolEmployees[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   Address?
  region   Region?
  subject  String?
  last_contacted TimestamptzString @default(now())
  branchRole String

  last_contacted_by Employee? @relation(fields: [last_contacted_byId], references: [id])
  last_contacted_byId Int?

  school   School? @relation(fields: [schoolId], references: [id])
  schoolId Int?

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model School {
  id        Int      @id
  name      String
  address   Address
  type      SchoolType
  relationship RelationshipType
  region   Region

  branchId Int
  branch Branch
  
  contacts Contact[]
  employees schoolEmployees[]
  participations Particpation[]
  }

model Particpation {
  id        Int      @id @default(autoincrement())
  
  startDate TimestamptzString
  endDate   TimestamptzString?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  employee Employee[]

  program Program @relation(fields: [programId], references: [id])
  programId Int
}

// do we need this? programs <-> participations <-> employees
model ParticipationEmployees {
  participationId Int
  employeeId Int

  participation Particpation @relation(fields: [participationId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([participationId, employeeId])
}

model SchoolEmployees {
  schoolId Int
  employeeId Int

  school School @relation(fields: [schoolId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([schoolId, employeeId])
}

model Program {
  id        Int      @id @default(autoincrement())
  name      String
  description String?
  
  // the municipality funding the program (optional)
  sponsor MunicipalityPrograms[]

  participations Particpation[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

 
model Branch {
  id Int @id @default(autoincrement())
  name Branches
  region Region 
  
  contacts Contact[]
  schools School[]
}

model Municipality {
  id Int 
  name String
  mayor String

  program MunicipalityPrograms[]

}

model MunicipalityPrograms {
  MunicipalityId Int
  ProgramId Int

  program Program @relation(fields: [programId], references: [id])
  municipality Municipality @relation(fields: [municipalityId], references: [id])
}
