// use prisma-8

//---------------------------TYPES AND ENUMS---------------------------//
type Address {
  street  String
  city    String
  country String
  zipCode String
}

enum RegionTypes {
  PRAHA
  STŘEDOČESKÝ
  JIHOČESKÝ
  PLZEŇSKÝ
  KARLOVARSKÝ
  ÚSTECKÝ
  LIBERECKÝ
  KRÁLOVÉHRADECKÝ
  PARDUBICKÝ
  JIHOMORAVSKÝ
  OLOMOUCKÝ
  ZLÍNSKÝ
  MORAVSKOSLEZSKÝ
  JIHLAVA
}

enum BranchTypes {
  SEVERNÍ_ČECHY
  VÝCHODNÍ_ČECHY
  STŘEDNÍ_MORAVA
  PLZEŇSKÝ_KRAJ
  JIŽNÍ_MORAVA
  JIŽNÍ_ČECHY
  KARLOVARSKÝ_KRAJ
  MORAVSKOSLEZSKÝ_KRAJ
  PRAHA
}

enum ProgramType {
  STORIES_OF_OUR_NEIGHBORS
  MEMORY_OF_NATIONS_THEATRE
  STORY_ON
  SCHOOL_NETWORK // Seminars
  EDUCATION_DEVELOPMENT
  WORKSHOPS
}

enum RelationshipTypes {
  POOR
  AVERAGE
  EXCELLENT
}

enum RoleTypes {
  ADMIN
  MARKETER
  WORKSHOPS_COORDINATOR
  SCHOOL_NETWORK_COORDINATOR
  STORIES_OF_OUR_NEIGHBORS_COORDINATOR
  VETERANS_DAY_COORDINATOR
  NEWSLETTER_COORDINATOR
  BRANCH_DIRECTOR
  HEAD_OF_EDUCATION
  PROJECT_MANAGER
  COORDINATOR
  DEVELOPMENT_LEAD
  PRODUCTION
  STUDIO_LEAD
  LECTURER
  METHODOLOGY_LEAD
}

enum ProgramStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContactTypes {
  TEACHER
  PRINCIPAL
  SCHOOL_COORDINATOR
  STUDENT

  HISTORIAN

  GOVERNMENT_OFFICIAL
  DONOR
  SPONSOR

  PARTNER
  VOLUNTEER
  OTHER
}

enum CommunicationMode {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO_CALL
  MESSAGE
  OTHER
}

//---------------------------MODELS---------------------------//
// Private, immutable snapshots. JSON stores the original addresses even if contacts change.
model EmailSegment {
  id Int @id @default(autoincrement())
  name String
  createdById Int
  filtersJson String
  contactsJson String
  contactCount Int
  createdAt TimestamptzString @default(now())

  @@index([createdById, id])
}

// A Message-ID is recorded once so mailbox retries cannot duplicate contact history.
model TrackedEmail {
  id String @id
  fingerprint String
  fromEmail String
  contactedAt TimestamptzString
  recipientEmails String
  matchedContactCount Int
  receivedAt TimestamptzString @default(now())
}

// Historical direct-send records are retained; the current email page does not send mail.
model EmailDispatch {
  id String @id
  actorId Int
  fingerprint String
  state String
  recipientCount Int
  providerEmailId Int?
  providerResult String?
  createdAt TimestamptzString @default(now())

  @@index([actorId, createdAt])
}

// Snapshots intentionally have no foreign keys: history survives deleted records/editors.
model EditHistory {
  id Int @id @default(autoincrement())
  recordType String
  recordId Int
  sourceTable String
  operation String
  beforeData String?
  afterData String?
  actorId Int?
  actorName String
  changedAt TimestamptzString @default(now())

  @@index([recordType, recordId, id])
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  pfpImgUrl String?
  phone     String?
  address   Address?
  region   Region?


  is_online  Boolean  @default(false)
  // remove this, because we might add EmployeeJobRole table later?
  roles      Role[]

  assignments EmployeeAssignment[]
  interactions Interaction[]
  chiefOf Branch[]
  participations ParticipationEmployees[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  participations ParticipationContacts[]
  employmentHistory ContactEmployment[]
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   Address?
  region   Region?
  // Cached summary of the latest interaction; maintained by application logic.
  last_contacted TimestamptzString @default(now())
  // Updated only by the authenticated CC-mailbox integration, never by copying addresses.
  lastTrackedEmailAt TimestamptzString?
  
  interactions Interaction[]

  contactRole ContactRole

  last_contacted_by Employee? @relation(fields: [last_contacted_byId], references: [id], onDelete: SetNull)
  last_contacted_byId Int?

  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId Int?

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
enum OrganizationTypes {
  PRIMARY_SCHOOL
  SECONDARY_SCHOOL
  THEATRE
  CULTURAL
}

// between program and school
model Participation {
  // contacts ParticipationContacts[]
  id        Int      @id @default(autoincrement())
  name      String
  
  startDate TimestamptzString
  endDate   TimestamptzString?
  status    ProgramStatus @default(PLANNED)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId Int?

  employee ParticipationEmployees[]

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId Int?
  programType ProgramType
}

// Roles may apply globally, or be scoped to a branch, program, and/or region.
// Multiple rows let an employee work across multiple programs and branches.
model EmployeeAssignment {
  id         Int @id @default(autoincrement())
  employeeId Int
  role       RoleTypes
  branchId   Int?  // Do we need this here? Redundant imo
  programId  Int?
  region     RegionTypes?

  employee Employee @relation(fields: [employeeId], references: [personId], onDelete: Cascade)
  branch   BranchTypes
  program  Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([branchId, programId])
}

// Each contact event is a separate row, including repeat conversations.
model Interaction {
  id                Int @id @default(autoincrement())
  employeeId        Int?
  personId          Int?
  organizationId    Int?
  programId         Int?
  contactedAt       TimestamptzString @default(now())
  mode              CommunicationMode

  employee Employee? @relation(fields: [employeeId], references: [personId], onDelete: SetNull)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  program  Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([employeeId, contactedAt])
  @@index([personId, contactedAt])
  @@index([organizationId, contactedAt])
  @@index([programId, contactedAt])
}

model Program {
  id        Int      @id @default(autoincrement())
  name      String
  description String?
  
  // the municipality funding the program (optional)
  sponsor MunicipalityPrograms[]
  assignments EmployeeAssignment[]
  interactions Interaction[]

  participations Participation[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model Branch {
  id Int @id @default(autoincrement())
  name BranchTypes
  institute String?
  chiefId Int?
  chief Employee? @relation(fields: [chiefId], references: [personId], onDelete: SetNull)
  region RegionTypes
  
  people  Person[]
  organization Organization[]
}

model Municipality {
  id Int @id @default(autoincrement())
  name String
  mayor String

  program MunicipalityPrograms[]

}

model MunicipalityPrograms {
  municipalityId Int
  programId Int

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@id([municipalityId, programId])
}

// Explicit employment periods of a teacher
model SmartEmailContact {
  id Int @id
  email String
  listsJson String
  hardBounced Boolean
  softBounces Int
  blacklisted Boolean
  syncedAt TimestamptzString

  @@index([email])
}

// Provider events stay separate from employee interactions and are safe to replay.
model SmartEmailEvent {
  id String @id
  email String
  messageId String
  type String
  occurredAt TimestamptzString
  campaignName String
  subject String
  campaignType String
  detailsJson String

  @@index([email, type, occurredAt])
  @@index([email, messageId])
}

model SmartEmailSync {
  id String @id
  streamId String
  contactOffset Int @default(0)
  contactsStartedAt TimestamptzString?
  contactsSyncedAt TimestamptzString?
  eventsSyncedAt TimestamptzString?
  lastAttemptAt TimestamptzString?
  lastError String?
  lockToken String?
  lockUntil TimestamptzString?
}

model PersonEmployment {
  id Int @id @default(autoincrement())
  personId Int
  orgId Int?
  jobTitle String
  startDate TimestamptzString
  endDate TimestamptzString?
  notes String?

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([personId, startDate])
  @@index([orgId])
}

// Contacts attending a specific occurrence of a program at a school.
model ParticipationContacts {
  participationId Int
  personId Int

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  people Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([participationId, personId])
  @@index([personId])
}

//* --------------------------- CHARLOTTE'S CHANGES --------------------------- *//
model Organization {
  id            Int @id @default(autoincrement())
  name          String
  phone         Char(10)?
  email         VarChar(50)?
  type          OrganizationTypes
  region        RegionTypes
  relationship  RelationshipTypes
  address       Address

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // interactions Interaction[]
  // contacts Contact[]
  participations Participation[]
  branch          Branch? @relation(fields: [branchId], references: [id])
  branchId        Int?
  people          Person[]
}

model Person {
  id      Int @id @default(autoincrement())
  name    String
  email   String? @unique
  phone   String?
  address Address?
  dob     DateString
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // FKs
  employee        Employee?
  student         Student?
  parent          Parent?
  organization    Organization? @relation(fields: [orgId], references: [id])
  orgId           Int?
  personRole      PersonRoles?
  branch          Branch? @relation(fields: [branchId], references: [id])
  branchId        Int?
  interactions    Interaction[]
  participations ParticipationContacts[]
  lastContactedById     Int?
  lastContactedBy       Employee? @relation(fields: [lastContactedById], references: [personId])
  lastContactedDate     DateString
}

model Student {
  personId  Int @id 
  person   Person @relation(fields: [personId], references: [id])

  orgId  Int
  org    Organization @relation(fields: [orgId], references: [id])

  parentId  Int
  parent   Parent @relation(fields: [parentId], references: [personId])
}

model Parent {
  personId  Int @id 
  person   Person @relation(fields: [personId], references: [id])

  students Student[]
}

model Employee {
  personId  Int @id 
  person   Person @relation(fields: [personId], references: [id])

  password  String
  pfpImgUrl String
  mustChangePassword Boolean @default(true)
  branch  Branch? @relation(fields: [branchId], references: [id])
  branchId  Int?
  role    RoleTypes[]

  assignments EmployeeAssignment[]
  interactions Interaction[]
  participation Participation[]

}

model ParticipationEmployees {
  particpationId Int
  employeeId  Int

  employee Employee @relation(fields: [employeeId], references: [personId])
  participation Participation @relation(fields: [particpationId], references: [id])

  @@id([particpationId, employeeId])
}

model PersonRoles {
  personId  Int @id
  person    Person @relation(fields: [personId], references: [id])
  type      ContactTypes
}