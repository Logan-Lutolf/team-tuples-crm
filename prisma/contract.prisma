//* --------------------------- CHARLOTTE'S CHANGES --------------------------- *//
model Organization {
  id            Int @id @default(autoincrement())
  name          String
  phone         Char(10)?
  email         VarChar(50)?
  type          OrganizationTypes
  region        RegionTypes
  relationship  RelationshipTypes
  branch        BranchTypes
  address       Address

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // interactions Interaction[]
  // contacts Contact[]
  participations Participation[]
}

model Person {
  id      Int @id @default(autoincrement())
  name    String
  email   String? @unique
  phone   String?
  address Address
  dob     Date
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // FKs
  employee        Employee?
  student         Student?
  parent          Parent?
  organization    Organization @relation(fields: [orgId], references: [id])
  orgId           Int
  // participations ParticipationContacts[]
}

model Student {
  personId  Int @id 
  person   Person @relation(fields: [personId], references: [id])

  orgId  Int
  org    Organization @relation(fields: [orgId], references: [id])

  parentId  Int
  parent   Parent @relation(fields: [parentId], references: [personId])

}

model Parent {
  personId  Int @id 
  person   Person @relation(fields: [personId], references: [id])

  students Student[]
}

model Employee {
  personId  Int @id 
  person   Person @relation(fields: [personId], references: [id])

  password  String
  pfpImgUrl String
  mustChangePassword Boolean @default(true)
  branch  BranchTypes

  // assignments EmployeeAssignment[]
  // interactions Interaction[]
  participation Participation[]
}

model ParticipationEmployees {
  particpationId Int
  employeeId  Int

  employee Employee @relation(fields: [employeeId], references: [personId])
  participation Participation @relation(fields: [particpationId], references: [id])

  @@id([particpationId, employeeId])
}

model OrganizationPeople {
  personId Int
  orgId  Int

  person Person @relation(fields: [personId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, personId])
}