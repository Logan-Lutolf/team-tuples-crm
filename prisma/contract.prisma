// use prisma-8

//---------------------------TYPES AND ENUMS---------------------------//
type Address {
  street  String
  city    String
  country String
  zipCode String
}

enum RegionTypes {
  PRAHA
  STŘEDOČESKÝ
  JIHOČESKÝ
  PLZEŇSKÝ
  KARLOVARSKÝ
  ÚSTECKÝ
  LIBERECKÝ
  KRÁLOVÉHRADECKÝ
  PARDUBICKÝ
  JIHOMORAVSKÝ
  OLOMOUCKÝ
  ZLÍNSKÝ
  MORAVSKOSLEZSKÝ
  JIHLAVA
}

enum BranchTypes {
  SEVERNÍ_ČECHY
  VÝCHODNÍ_ČECHY
  STŘEDNÍ_MORAVA
  PLZEŇSKÝ_KRAJ
  JIŽNÍ_MORAVA
  JIŽNÍ_ČECHY
  KARLOVARSKÝ_KRAJ
  MORAVSKOSLEZSKÝ_KRAJ
  PRAHA
}

enum ProgramType {
  STORIES_OF_OUR_NEIGHBORS
  MEMORY_OF_NATIONS_THEATRE
  STORY_ON
  SCHOOL_NETWORK // Seminars
  EDUCATION_DEVELOPMENT
  WORKSHOPS
}

enum RelationshipTypes {
  POOR
  AVERAGE
  EXCELLENT
}

enum Role {
  ADMIN
  WORKSHOPS_COORDINATOR
  SCHOOL_NETWORK_COORDINATOR
  STORIES_OF_OUR_NEIGHBORS_COORDINATOR
  VETERANS_DAY_COORDINATOR
  NEWSLETTER_COORDINATOR
  BRANCH_DIRECTOR
  HEAD_OF_EDUCATION
  PROJECT_MANAGER
  COORDINATOR
  DEVELOPMENT_LEAD
  PRODUCTION
  STUDIO_LEAD
  LECTURER
  METHODOLOGY_LEAD
}

enum ProgramStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContactRole {
  TEACHER
  PRINCIPAL
  SCHOOL_COORDINATOR
  STUDENT

  HISTORIAN

  GOVERNMENT_OFFICIAL
  DONOR
  SPONSOR

  PARTNER
  VOLUNTEER
  OTHER
}

enum CommunicationMode {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO_CALL
  MESSAGE
  OTHER
}

enum OrganizationTypes {
  PRIMARY_SCHOOL
  SECONDARY_SCHOOL
  THEATRE
  CULTURAL
}

//---------------------------MODELS---------------------------//
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  pfpImgUrl String?
  phone     String?
  address   Address?
  region   RegionTypes?
  mustChangePassword  Boolean @default(true)


  is_online  Boolean  @default(false)
  roles      Role[]

  assignments EmployeeAssignment[]
  interactions Interaction[]
  chiefOf Branch[]
  participations ParticipationEmployees[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  participations ParticipationContacts[]
  employmentHistory ContactEmployment[]
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   Address?
  region   RegionTypes?
  // Cached summary of the latest interaction; maintained by application logic.
  last_contacted TimestamptzString @default(now())
  
  interactions Interaction[]

  contactRole ContactRole

  last_contacted_by Employee? @relation(fields: [last_contacted_byId], references: [id], onDelete: SetNull)
  last_contacted_byId Int?

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId Int?

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model School {
  contactEmployments ContactEmployment[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  id        Int      @id
  name      String
  address   Address
  type      OrganizationTypes
  phone String?
  email String @unique
  relationship RelationshipTypes
  region   RegionTypes

  branchId Int?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  }

// between program and school
model Participation {
  contacts ParticipationContacts[]
  id        Int      @id @default(autoincrement())
  name      String
  
  startDate TimestamptzString
  endDate   TimestamptzString?
  status    ProgramStatus @default(PLANNED)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId Int?

  employee ParticipationEmployees[]

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId Int?
  programType ProgramType
}

// shows an employee is working on a participation
model ParticipationEmployees {
  participationId Int
  employeeId Int

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([participationId, employeeId])
}

// Roles may apply globally, or be scoped to a branch, program, and/or region.
// Multiple rows let an employee work across multiple programs and branches.
model EmployeeAssignment {
  id         Int @id @default(autoincrement())
  employeeId Int
  role       Role
  branchId   Int?
  programId  Int?
  region     RegionTypes?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  program  Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([branchId, programId])
}

// Each contact event is a separate row, including repeat conversations.
model Interaction {
  id                Int @id @default(autoincrement())
  employeeId        Int?
  contactId         Int?
  organizationId    Int?
  programId         Int?
  contactedAt       TimestamptzString @default(now())
  mode              CommunicationMode

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  program  Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([employeeId, contactedAt])
  @@index([contactId, contactedAt])
  @@index([organizationId, contactedAt])
  @@index([programId, contactedAt])
}

model Program {
  id        Int      @id @default(autoincrement())
  name      String
  description String?
  
  // the municipality funding the program (optional)
  sponsor MunicipalityPrograms[]
  assignments EmployeeAssignment[]
  interactions Interaction[]

  participations Participation[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model Branch {
  id Int @id @default(autoincrement())
  name BranchTypes
  institute String?
  chiefId Int?
  chief Employee? @relation(fields: [chiefId], references: [id], onDelete: SetNull)
  assignments EmployeeAssignment[]
  region RegionTypes
  
  contacts Contact[]
  schools School[]
}

model Municipality {
  id Int @id @default(autoincrement())
  name String
  mayor String

  program MunicipalityPrograms[]

}

model MunicipalityPrograms {
  municipalityId Int
  programId Int

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@id([municipalityId, programId])
}

// Explicit employment periods of a teacher
model ContactEmployment {
  id Int @id @default(autoincrement())
  contactId Int
  schoolId Int?
  jobTitle String
  startDate TimestamptzString
  endDate TimestamptzString?
  notes String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([contactId, startDate])
  @@index([schoolId])
}

// Contacts attending a specific occurrence of a program at a school.
model ParticipationContacts {
  participationId Int
  contactId Int

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([participationId, contactId])
  @@index([contactId])
}


model Organization {
  id            cuid2()
  name          String
  phone         Char(10)?
  email         VarChar(50)?
  type          OrganizationTypes
  region        RegionTypes
  relationship  RelationshipTypes
  branch        BranchTypes
  address       Address

  interactions Interaction[]
  contacts Contact[]
  participations Participation[]
}