// use prisma-8

//---------------------------TYPES AND ENUMS---------------------------//
type Address {
  street  String
  city    String
  country String
  zipCode String
}

enum Region {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
  ELEVEN
  TWELVE
  THIRTEEN
  FOURTEEN
}

enum Branches {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
}

enum SchoolType {
  PRIMARY
  SECONDARY
  UNDERGRADUATE
  GRADUATE
  POSTGRADUATE
}

enum RelationshipType {
  POOR
  AVERAGE
  EXCELLENT
}

enum EmployeeJobRole {
  ADMIN
  WORKSHOPS_COORDINATOR
  SCHOOL_NETWORK_COORDINATOR
  STORIES_OF_OUR_NEIGHBORS_COORDINATOR
  VETERANS_DAY_COORDINATOR
  NEWSLETTER_COORDINATOR
  BRANCH_DIRECTOR
  HEAD_OF_EDUCATION
  PROJECT_MANAGER
  COORDINATOR
  DEVELOPMENT_LEAD
  PRODUCTION
  STUDIO_LEAD
  LECTURER
  METHODOLOGY_LEAD

}

enum ProgramStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContactRole {
  TEACHER
  PRINCIPAL
  SCHOOL_COORDINATOR
  STUDENT

  HISTORIAN

  GOVERNMENT_OFFICIAL
  DONOR
  SPONSOR

  PARTNER
  VOLUNTEER
  OTHER
}

enum CommunicationMode {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO_CALL
  MESSAGE
  OTHER
}

//---------------------------MODELS---------------------------//
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   Address?
  region   Region?

  is_online  Boolean  @default(false)
  assignments EmployeeAssignment[]
  interactions Interaction[]
  chiefOf Branch[]
  legacySchoolLinks LegacySchoolEmployees[]
  participations ParticipationEmployees[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   Address?
  region   Region?
  // Cached summary of the latest interaction; maintained by application logic.
  last_contacted TimestamptzString @default(now())
  
  interactions Interaction[]

  contactRole ContactRole

  last_contacted_by Employee? @relation(fields: [last_contacted_byId], references: [id])
  last_contacted_byId Int?

  school   School? @relation(fields: [schoolId], references: [id])
  schoolId Int?

  branchId Int
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model School {
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  id        Int      @id
  name      String
  address   Address
  type      SchoolType
  phone String?
  email String @unique
  relationship RelationshipType
  region   Region

  branchId Int
  branch Branch @relation(fields: [branchId], references: [id])
  
  contacts Contact[]
  legacyEmployeeLinks LegacySchoolEmployees[]
  interactions Interaction[]
  participations Participation[]
  }

// between program and school
model Participation {
  id        Int      @id @default(autoincrement())
  name      String
  
  startDate TimestamptzString
  endDate   TimestamptzString?
  status    ProgramStatus @default(PLANNED)

  school   School @relation(fields: [schoolId], references: [id])
  schoolId Int

  employee ParticipationEmployees[]

  program Program @relation(fields: [programId], references: [id])
  programId Int
}

// shows an employee is working on a participation
model ParticipationEmployees {
  participationId Int
  employeeId Int

  participation Participation @relation(fields: [participationId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([participationId, employeeId])
}

// Roles may apply globally, or be scoped to a branch, program, and/or region.
// Multiple rows let an employee work across multiple programs and branches.
model EmployeeAssignment {
  id         Int @id @default(autoincrement())
  employeeId Int
  role       EmployeeJobRole
  branchId   Int?
  programId  Int?
  region     Region?

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch? @relation(fields: [branchId], references: [id])
  program  Program? @relation(fields: [programId], references: [id])

  @@index([employeeId])
  @@index([branchId, programId])
}

// Each contact event is a separate row, including repeat conversations.
model Interaction {
  id         Int @id @default(autoincrement())
  employeeId Int
  contactId  Int
  schoolId   Int?
  programId  Int?
  contactedAt TimestamptzString @default(now())
  mode       CommunicationMode

  employee Employee @relation(fields: [employeeId], references: [id])
  contact  Contact @relation(fields: [contactId], references: [id])
  school   School? @relation(fields: [schoolId], references: [id])
  program  Program? @relation(fields: [programId], references: [id])

  @@index([employeeId, contactedAt])
  @@index([contactId, contactedAt])
  @@index([schoolId, contactedAt])
  @@index([programId, contactedAt])
}

model Program {
  id        Int      @id @default(autoincrement())
  name      String
  description String?
  
  // the municipality funding the program (optional)
  sponsor MunicipalityPrograms[]
  assignments EmployeeAssignment[]
  interactions Interaction[]

  participations Participation[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model Branch {
  id Int @id @default(autoincrement())
  name Branches
  institute String?
  chiefId Int?
  chief Employee? @relation(fields: [chiefId], references: [id])
  assignments EmployeeAssignment[]
  region Region 
  
  contacts Contact[]
  schools School[]
}

model Municipality {
  id Int @id @default(autoincrement())
  name String
  mayor String

  program MunicipalityPrograms[]

}

model MunicipalityPrograms {
  municipalityId Int
  programId Int

  program Program @relation(fields: [programId], references: [id])
  municipality Municipality @relation(fields: [municipalityId], references: [id])

  @@id([municipalityId, programId])
}


// Historical assignments are archived without inventing contact events or timestamps.
// New contact history belongs in Interaction.
model LegacySchoolEmployees {
  schoolId Int
  employeeId Int

  school School @relation(fields: [schoolId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([schoolId, employeeId])
}
