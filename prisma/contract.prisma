// use prisma-8

//---------------------------TYPES AND ENUMS---------------------------//
type Address {
  street  String
  city    String
  country String
  zipCode String
}

enum Region {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
  ELEVEN
  TWELVE
  THIRTEEN
  FOURTEEN
}

enum Branches {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
}

enum SchoolType {
  PRIMARY
  SECONDARY
  UNDERGRADUATE
  GRADUATE
  POSTGRADUATE
}

enum RelationshipType {
  POOR
  AVERAGE
  EXCELLENT
}

enum Role {
  ADMIN
  MARKETER
  WORKSHOPS_COORDINATOR
  SCHOOL_NETWORK_COORDINATOR
  STORIES_OF_OUR_NEIGHBORS_COORDINATOR
  VETERANS_DAY_COORDINATOR
  NEWSLETTER_COORDINATOR
  BRANCH_DIRECTOR
  HEAD_OF_EDUCATION
  PROJECT_MANAGER
  COORDINATOR
  DEVELOPMENT_LEAD
  PRODUCTION
  STUDIO_LEAD
  LECTURER
  METHODOLOGY_LEAD
}

enum ProgramStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ContactRole {
  TEACHER
  PRINCIPAL
  SCHOOL_COORDINATOR
  STUDENT

  HISTORIAN

  GOVERNMENT_OFFICIAL
  DONOR
  SPONSOR

  PARTNER
  VOLUNTEER
  OTHER
}

enum CommunicationMode {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO_CALL
  MESSAGE
  OTHER
}

//---------------------------MODELS---------------------------//
// Private, immutable snapshots. JSON stores the original addresses even if contacts change.
model EmailSegment {
  id Int @id @default(autoincrement())
  name String
  createdById Int
  filtersJson String
  contactsJson String
  contactCount Int
  createdAt TimestamptzString @default(now())

  @@index([createdById, id])
}

// A Message-ID is recorded once so mailbox retries cannot duplicate contact history.
model TrackedEmail {
  id String @id
  fingerprint String
  fromEmail String
  contactedAt TimestamptzString
  recipientEmails String
  matchedContactCount Int
  receivedAt TimestamptzString @default(now())
}

// Historical direct-send records are retained; the current email page does not send mail.
model EmailDispatch {
  id String @id
  actorId Int
  fingerprint String
  state String
  recipientCount Int
  providerEmailId Int?
  providerResult String?
  createdAt TimestamptzString @default(now())

  @@index([actorId, createdAt])
}

// Snapshots intentionally have no foreign keys: history survives deleted records/editors.
model EditHistory {
  id Int @id @default(autoincrement())
  recordType String
  recordId Int
  sourceTable String
  operation String
  beforeData String?
  afterData String?
  actorId Int?
  actorName String
  changedAt TimestamptzString @default(now())

  @@index([recordType, recordId, id])
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  pfpImgUrl String?
  phone     String?
  address   Address?
  region   Region?


  is_online  Boolean  @default(false)
  // remove this, because we might add EmployeeJobRole table later?
  roles      Role[]

  assignments EmployeeAssignment[]
  interactions Interaction[]
  chiefOf Branch[]
  participations ParticipationEmployees[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Contact {
  participations ParticipationContacts[]
  employmentHistory ContactEmployment[]
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   Address?
  region   Region?
  // Cached summary of the latest interaction; maintained by application logic.
  last_contacted TimestamptzString @default(now())
  // Updated only by the authenticated CC-mailbox integration, never by copying addresses.
  lastTrackedEmailAt TimestamptzString?
  
  interactions Interaction[]

  contactRole ContactRole

  last_contacted_by Employee? @relation(fields: [last_contacted_byId], references: [id], onDelete: SetNull)
  last_contacted_byId Int?

  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId Int?

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model School {
  contactEmployments ContactEmployment[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  id        Int      @id
  name      String
  address   Address
  type      SchoolType
  phone String?
  email String @unique
  relationship RelationshipType
  region   Region

  branchId Int?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  contacts Contact[]
  interactions Interaction[]
  participations Participation[]
  }

// between program and school
model Participation {
  contacts ParticipationContacts[]
  id        Int      @id @default(autoincrement())
  name      String
  
  startDate TimestamptzString
  endDate   TimestamptzString?
  status    ProgramStatus @default(PLANNED)

  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId Int?

  employee ParticipationEmployees[]

  program Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId Int?
}

// shows an employee is working on a participation
model ParticipationEmployees {
  participationId Int
  employeeId Int

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([participationId, employeeId])
}

// Roles may apply globally, or be scoped to a branch, program, and/or region.
// Multiple rows let an employee work across multiple programs and branches.
model EmployeeAssignment {
  id         Int @id @default(autoincrement())
  employeeId Int
  role       Role
  branchId   Int?
  programId  Int?
  region     Region?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  program  Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([branchId, programId])
}

// Each contact event is a separate row, including repeat conversations.
model Interaction {
  id         Int @id @default(autoincrement())
  employeeId Int?
  contactId  Int?
  schoolId   Int?
  programId  Int?
  contactedAt TimestamptzString @default(now())
  mode       CommunicationMode

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  program  Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([employeeId, contactedAt])
  @@index([contactId, contactedAt])
  @@index([schoolId, contactedAt])
  @@index([programId, contactedAt])
}

model Program {
  id        Int      @id @default(autoincrement())
  name      String
  description String?
  
  // the municipality funding the program (optional)
  sponsor MunicipalityPrograms[]
  assignments EmployeeAssignment[]
  interactions Interaction[]

  participations Participation[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model Branch {
  id Int @id @default(autoincrement())
  name Branches
  institute String?
  chiefId Int?
  chief Employee? @relation(fields: [chiefId], references: [id], onDelete: SetNull)
  assignments EmployeeAssignment[]
  region Region 
  
  contacts Contact[]
  schools School[]
}

model Municipality {
  id Int @id @default(autoincrement())
  name String
  mayor String

  program MunicipalityPrograms[]

}

model MunicipalityPrograms {
  municipalityId Int
  programId Int

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@id([municipalityId, programId])
}

// Explicit employment periods of a teacher
model SmartEmailContact {
  id Int @id
  email String
  listsJson String
  hardBounced Boolean
  softBounces Int
  blacklisted Boolean
  syncedAt TimestamptzString

  @@index([email])
}

// Provider events stay separate from employee interactions and are safe to replay.
model SmartEmailEvent {
  id String @id
  email String
  messageId String
  type String
  occurredAt TimestamptzString
  campaignName String
  subject String
  campaignType String
  detailsJson String

  @@index([email, type, occurredAt])
  @@index([email, messageId])
}

model SmartEmailSync {
  id String @id
  streamId String
  contactOffset Int @default(0)
  contactsStartedAt TimestamptzString?
  contactsSyncedAt TimestamptzString?
  eventsSyncedAt TimestamptzString?
  lastAttemptAt TimestamptzString?
  lastError String?
  lockToken String?
  lockUntil TimestamptzString?
}

model ContactEmployment {
  id Int @id @default(autoincrement())
  contactId Int
  schoolId Int?
  jobTitle String
  startDate TimestamptzString
  endDate TimestamptzString?
  notes String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([contactId, startDate])
  @@index([schoolId])
}

// Contacts attending a specific occurrence of a program at a school.
model ParticipationContacts {
  participationId Int
  contactId Int

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([participationId, contactId])
  @@index([contactId])
}
