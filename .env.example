# Existing app settings: use your actual database URL and a random session secret.
DATABASE_URL="postgresql://user:password@localhost:5432/crm"
SECRET_KEY="replace-with-a-random-session-secret"

# CC tracking: mailbox and trusted mailbox-to-CRM connector, configured by IT.
EMAIL_TRACKING_CC_ADDRESS="pb-tracker@YOUR-TENANT.onmicrosoft.com"
EMAIL_TRACKING_WEBHOOK_SECRET=""
# Optional comma-separated shared sender addresses that are not employee accounts.
EMAIL_TRACKING_ALLOWED_SENDERS=""

# Microsoft 365 connector. The SAME CC address above is also the mailbox to read.
# A mailbox password is never used by this application.
EMAIL_TRACKING_SYNC_URL="http://localhost:3000/api/email-tracking"
M365_TENANT_ID=""
M365_CLIENT_ID=""
M365_CLIENT_SECRET=""
# Separate random 32+ character value stamped by the Exchange mail-flow rules.
M365_VERIFIED_SENDER_SECRET=""
# Persistent private directory for mailbox-specific progress and locks.
EMAIL_TRACKING_STATE_DIRECTORY=".local/cc-tracking"

# Read-only SmartEmailing imports. These credentials stay on the server.
SMARTEMAILING_USERNAME=""
SMARTEMAILING_API_KEY=""
SMARTEMAILING_EVENT_STREAM_ID=""
SMARTEMAILING_SYNC_SECRET=""
# Used by the scheduler runner; replace with the deployed HTTPS URL in production.
SMARTEMAILING_SYNC_URL="http://localhost:3000/api/smartemailing/sync"
