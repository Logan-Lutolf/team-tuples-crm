@@ -0,0 +1,20 @@
+import 'server-only'
+import { cache } from 'react'
+import { cookies } from 'next/headers'
+import { decrypt } from '@/app/login/sessions'
+import { db } from '@/prisma/db'
+
+// Read current roles from Postgres; a previously issued cookie must not preserve revoked access.
+export const currentEmployee = cache(async () => {
+    const session = (await cookies()).get('session')?.value
+    if (!session) return null
+    const payload = await decrypt(session)
+    if (!payload || !Number.isSafeInteger(payload.userId) || payload.userId <= 0) return null
+    const [employee, person] = await Promise.all([
+        db.orm.public.Employee.where({ personId: payload.userId }).select('personId', 'role').first(),
+        db.orm.public.Person.where({ id: payload.userId }).select('id', 'name', 'email').first(),
+    ])
+    if (!employee || !person) return null
+    // Global page access uses Employee.role. A scoped assignment must not grant global access.
+    return { id: employee.personId, name: person.name, email: person.email ?? '', roles: employee.role }
+})
diff --git a/lib/email-contacts-server.ts b/lib/email-contacts-server.ts
new file mode 100644
index 0000000..da0da41
--- /dev/null
+++ b/lib/email-contacts-server.ts
@@ -0,0 +1,60 @@
+import 'server-only'
+import { db } from '@/prisma/db'
+import { currentEmployee } from '@/lib/current-employee'
+import { canUseEmailContacts, type SmartCampaignActivity, type SmartEmailFiltersData, type EmailContact } from '@/lib/email-contacts'
+
+export async function requireEmailAccess() {
+    const employee = await currentEmployee()
+    if (!employee || !canUseEmailContacts(employee.roles)) throw new Error('Only administrators and coordinators can use email contacts.')
+    return employee
+}
+
+export async function loadEmailContacts(): Promise<EmailContact[]> {
+    const [contacts, organizations, branches, roles, activity, profiles] = await Promise.all([
+        db.orm.public.Person.select('id', 'name', 'email', 'orgId', 'branchName', 'lastTrackedEmailAt').orderBy(c => c.name.asc()).all().toArray(),
+        db.orm.public.Organization.select('id', 'name', 'region').all().toArray(),
+        db.orm.public.Branch.select('name', 'region').all().toArray(),
+        db.orm.public.PersonRoles.all().toArray(),
+        db.runtime().query(db.raw.sql`SELECT e.email, e."campaignName" AS name,
+            max(e."occurredAt") FILTER (WHERE e.type = 'email.delivered')::text AS delivered,
+            COALESCE(jsonb_agg(DISTINCT to_char(e."occurredAt" AT TIME ZONE 'Europe/Prague', 'YYYY-MM-DD')) FILTER (WHERE e.type = 'email.opened'), '[]'::jsonb)::text AS opens,
+            COALESCE(jsonb_agg(DISTINCT to_char(e."occurredAt" AT TIME ZONE 'Europe/Prague', 'YYYY-MM-DD')) FILTER (WHERE e.type = 'email.clicked'), '[]'::jsonb)::text AS clicks
+            FROM public."SmartEmailEvent" e
+            WHERE e.type IN ('email.delivered', 'email.opened', 'email.clicked')
+              AND EXISTS (SELECT 1 FROM public."Person" c WHERE lower(trim(c.email)) = e.email)
+            GROUP BY e.email, e."campaignName"`
+            .returnsRow({ email: { codecId: 'pg/text@1' }, name: { codecId: 'pg/text@1' }, delivered: { codecId: 'pg/text@1' }, opens: { codecId: 'pg/text@1' }, clicks: { codecId: 'pg/text@1' } }).build()),
+        db.runtime().query(db.raw.sql`SELECT p.email, p."listsJson" AS lists, p.blacklisted, p."hardBounced" AS hard, p."softBounces" AS soft
+            FROM public."SmartEmailContact" p JOIN public."SmartEmailSync" s ON s.id = 'smartemailing'
+            WHERE p."syncedAt" >= s."contactsSyncedAt"
+              AND EXISTS (SELECT 1 FROM public."Person" c WHERE lower(trim(c.email)) = p.email)
+            ORDER BY p."syncedAt" DESC`
+            .returnsRow({ email: { codecId: 'pg/text@1' }, lists: { codecId: 'pg/text@1' }, blacklisted: { codecId: 'pg/bool@1' }, hard: { codecId: 'pg/bool@1' }, soft: { codecId: 'pg/int4@1' } }).build()),
+    ])
+    const campaignsByEmail = new Map<string, SmartCampaignActivity[]>()
+    const deliveryDates = new Map<string, string>()
+    for (const row of activity) {
+        const campaigns = campaignsByEmail.get(row.email) ?? []
+        campaigns.push({ name: row.name, deliveredAt: row.delivered, openDates: JSON.parse(row.opens), clickDates: JSON.parse(row.clicks) })
+        campaignsByEmail.set(row.email, campaigns)
+        if (row.delivered && (!deliveryDates.has(row.email) || Date.parse(row.delivered) > Date.parse(deliveryDates.get(row.email)!))) deliveryDates.set(row.email, row.delivered)
+    }
+    const profilesByEmail = new Map<string, SmartEmailFiltersData>()
+    for (const row of profiles) {
+        if (!profilesByEmail.has(row.email)) profilesByEmail.set(row.email, { lists: JSON.parse(row.lists), blacklisted: row.blacklisted, hardBounced: row.hard, softBounces: row.soft })
+    }
+    const organizationById = new Map(organizations.map(o => [o.id, o]))
+    const branchByName = new Map(branches.map(b => [b.name, b]))
+    const roleByPerson = new Map(roles.map(r => [r.personId, r.type]))
+    // Keep master's UI snapshot keys; schoolId now identifies an Organization and branchId a branch name.
+    return contacts.map(contact => ({
+        id: contact.id, name: contact.name, email: contact.email ?? '', role: roleByPerson.get(contact.id) ?? 'OTHER',
+        schoolId: contact.orgId, school: organizationById.get(contact.orgId ?? -1)?.name ?? '',
+        branchId: contact.branchName, branch: contact.branchName ?? '',
+        region: organizationById.get(contact.orgId ?? -1)?.region ?? (contact.branchName ? branchByName.get(contact.branchName)?.region : null) ?? null,
+        lastTrackedEmailAt: contact.lastTrackedEmailAt,
+        smartEmailingLastDeliveredAt: deliveryDates.get(contact.email?.trim().toLowerCase() ?? '') ?? null,
+        smartEmailing: profilesByEmail.get(contact.email?.trim().toLowerCase() ?? '') ?? null,
+        smartCampaigns: campaignsByEmail.get(contact.email?.trim().toLowerCase() ?? '') ?? [],
+    }))
+}
diff --git a/lib/email-contacts.ts b/lib/email-contacts.ts
new file mode 100644
index 0000000..9721951
--- /dev/null
+++ b/lib/email-contacts.ts
@@ -0,0 +1,127 @@
+export type SmartEmailFiltersData = {
+    lists: { id: number; name: string; status: 'confirmed' | 'unsubscribed' }[]
+    blacklisted: boolean; hardBounced: boolean; softBounces: number
+}
+export type SmartCampaignActivity = { name: string; deliveredAt: string | null; openDates: string[]; clickDates: string[] }
+
+// These helpers are shared by the page and snapshot actions so they filter identically.
+export type EmailContact = {
+    id: number; name: string; email: string; role: string
+    schoolId: number | null; school: string
+    branchId: string | null; branch: string; region: string | null
+    lastTrackedEmailAt: string | null
+    smartEmailingLastDeliveredAt?: string | null
+    smartEmailing?: SmartEmailFiltersData | null
+    smartCampaigns?: SmartCampaignActivity[]
+}
+export type ContactFilters = {
+    name: string; email: string; role: string; school: string; branch: string; region: string
+    lastEmail: 'any' | 'never' | 'contacted'; since: string; until: string
+    mailingList: string; subscription: 'any' | 'subscribed' | 'unsubscribed' | 'blacklisted' | 'unknown'
+    bounce: 'any' | 'hard' | 'soft' | 'none' | 'unknown'; campaign: string
+    engagement: 'any' | 'opened' | 'clicked' | 'unopened' | 'unclicked'; engagementSince: string; engagementUntil: string
+}
+export const emptyContactFilters: ContactFilters = {
+    name: '', email: '', role: '', school: '', branch: '', region: '', lastEmail: 'any', since: '', until: '',
+    mailingList: '', subscription: 'any', bounce: 'any', campaign: '', engagement: 'any', engagementSince: '', engagementUntil: '',
+}
+export type SegmentSummary = { id: number; name: string; contactCount: number; createdAt: string }
+export type SavedSegment = SegmentSummary & { contacts: EmailContact[]; filters: ContactFilters }
+
+export function canUseEmailContacts(roles: readonly string[]) {
+    return roles.some(role => role === 'ADMIN' || role === 'COORDINATOR' || role.endsWith('_COORDINATOR'))
+}
+
+export function validEmail(value: string) {
+    const email = value.trim(), local = email.split('@')[0]
+    return email.length <= 254 && local.length <= 64 && !local.startsWith('.') && !local.endsWith('.') && !local.includes('..') &&
+        /^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$/i.test(email)
+}
+
+export function validateContactFilters(raw: unknown): ContactFilters {
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('Invalid contact filters.')
+    const result = { ...emptyContactFilters }
+    for (const key of Object.keys(result) as (keyof ContactFilters)[]) {
+        const value = (raw as Record<string, unknown>)[key] ?? result[key]
+        if (typeof value !== 'string' || value.length > 200) throw new Error('Invalid contact filters.')
+        Object.assign(result, { [key]: value.trim() })
+    }
+    if (!['any', 'never', 'contacted'].includes(result.lastEmail)) throw new Error('Choose a valid last-email filter.')
+    if (!['any', 'subscribed', 'unsubscribed', 'blacklisted', 'unknown'].includes(result.subscription) ||
+        !['any', 'hard', 'soft', 'none', 'unknown'].includes(result.bounce) ||
+        !['any', 'opened', 'clicked', 'unopened', 'unclicked'].includes(result.engagement)) throw new Error('Choose valid SmartEmailing filters.')
+    if (result.mailingList && !/^[1-9]\d*$/.test(result.mailingList)) throw new Error('Choose a valid mailing list.')
+    for (const date of [result.since, result.until, result.engagementSince, result.engagementUntil]) {
+        if (date && (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !Number.isFinite(Date.parse(date)) || new Date(date).toISOString().slice(0, 10) !== date)) {
+            throw new Error('Choose valid filter dates.')
+        }
+    }
+    if (result.since && result.until && result.since > result.until) throw new Error('The start date must be on or before the end date.')
+    if (result.engagementSince && result.engagementUntil && result.engagementSince > result.engagementUntil) throw new Error('The engagement start date must be on or before the end date.')
+    if (result.engagement === 'any' && (result.engagementSince || result.engagementUntil)) throw new Error('Choose an open or click filter for the engagement dates.')
+    return result
+}
+
+// Calendar filters and displayed times use Post Bellum's local timezone.
+export function emailDate(value: string) {
+    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Prague', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(value))
+    const part = (type: string) => parts.find(part => part.type === type)!.value
+    return `${part('year')}-${part('month')}-${part('day')}`
+}
+
+// Old saved snapshots have no newsletter date; their original CC date remains valid.
+export function lastEmailAt(contact: EmailContact) {
+    const dates = [contact.lastTrackedEmailAt, contact.smartEmailingLastDeliveredAt].filter((value): value is string => Boolean(value))
+    return dates.sort((a, b) => Date.parse(b) - Date.parse(a))[0] ?? null
+}
+
+export function filterEmailContacts(contacts: readonly EmailContact[], filters: ContactFilters) {
+    return contacts.filter(contact => {
+        if (!contact.name.toLowerCase().includes(filters.name.trim().toLowerCase()) || !contact.email.toLowerCase().includes(filters.email.trim().toLowerCase())) return false
+        if (filters.role && contact.role !== filters.role) return false
+        if (filters.region && contact.region !== filters.region) return false
+        if (filters.school && (filters.school === 'none' ? contact.schoolId !== null : String(contact.schoolId) !== filters.school)) return false
+        if (filters.branch && (filters.branch === 'none' ? contact.branchId !== null : String(contact.branchId) !== filters.branch)) return false
+        const lastEmail = lastEmailAt(contact)
+        if (filters.lastEmail === 'never' && lastEmail !== null) return false
+        if (filters.lastEmail === 'contacted' && !lastEmail) return false
+        if (filters.since || filters.until) {
+            if (!lastEmail) return false
+            const date = emailDate(lastEmail)
+            if (filters.since && date < filters.since) return false
+            if (filters.until && date > filters.until) return false
+        }
+        const profile = contact.smartEmailing
+        const memberships = (profile?.lists ?? []).filter(list => !filters.mailingList || String(list.id) === filters.mailingList)
+        if (filters.mailingList && !memberships.length) return false
+        if (filters.subscription === 'unknown' && profile) return false
+        if (filters.subscription === 'blacklisted' && !profile?.blacklisted) return false
+        if (filters.subscription === 'subscribed' && (!profile || profile.blacklisted || !memberships.some(list => list.status === 'confirmed'))) return false
+        if (filters.subscription === 'unsubscribed' && !memberships.some(list => list.status === 'unsubscribed')) return false
+        if (filters.bounce === 'unknown' && profile) return false
+        if (filters.bounce === 'hard' && !profile?.hardBounced) return false
+        if (filters.bounce === 'soft' && (!profile || profile.hardBounced || profile.softBounces === 0)) return false
+        if (filters.bounce === 'none' && (!profile || profile.hardBounced || profile.softBounces > 0)) return false
+        // Campaign and engagement must match the same campaign, not unrelated newsletters.
+        const campaigns = (contact.smartCampaigns ?? []).filter(campaign => campaign.name.toLowerCase().includes(filters.campaign.trim().toLowerCase()))
+        if (filters.campaign && !campaigns.length) return false
+        if (filters.engagement !== 'any') {
+            if (!campaigns.length) return false
+            const dateField = ['opened', 'unopened'].includes(filters.engagement) ? 'openDates' : 'clickDates'
+            const hasEvent = campaigns.some(campaign => campaign[dateField].some(date =>
+                (!filters.engagementSince || date >= filters.engagementSince) && (!filters.engagementUntil || date <= filters.engagementUntil)))
+            const wantsEvent = ['opened', 'clicked'].includes(filters.engagement)
+            if (hasEvent !== wantsEvent) return false
+        }
+        return true
+    })
+}
+
+export function contactEmails(contacts: readonly Pick<EmailContact, 'email'>[]) {
+    const unique = new Map<string, string>()
+    for (const { email } of contacts) {
+        const trimmed = email.trim()
+        if (validEmail(trimmed) && !unique.has(trimmed.toLowerCase())) unique.set(trimmed.toLowerCase(), trimmed)
+    }
+    return [...unique.values()]
+}
diff --git a/lib/email-tracking-input.ts b/lib/email-tracking-input.ts
new file mode 100644
index 0000000..8ef9f83
--- /dev/null
+++ b/lib/email-tracking-input.ts
@@ -0,0 +1,31 @@
+import { createHash } from 'node:crypto'
+import { validEmail } from './email-contacts'
+
+export class EmailTrackingError extends Error {
+    status: number
+    constructor(message: string, status = 400) { super(message); this.status = status }
+}
+export type TrackedEmailInput = { messageId: string; from: string; recipients: string[]; contactedAt: string; fingerprint: string }
+
+export function validateTrackedEmail(raw: unknown, trackingMailbox: string, now = Date.now()): TrackedEmailInput {
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new EmailTrackingError('Expected an email metadata object.')
+    const value = raw as Record<string, unknown>
+    // The trusted mailbox relay must verify the original sender, not merely trust From headers.
+    if (value.senderVerified !== true) throw new EmailTrackingError('The relay must verify the original sender.', 403)
+    if (typeof value.messageId !== 'string' || !value.messageId.trim() || value.messageId.length > 998 || !/^[\x21-\x7e]+$/.test(value.messageId.trim())) throw new EmailTrackingError('A valid original Message-ID is required.')
+    if (typeof value.from !== 'string' || !validEmail(value.from)) throw new EmailTrackingError('A valid sender address is required.')
+    const addresses = (key: 'to' | 'cc') => {
+        const list = value[key]
+        if (!Array.isArray(list) || list.length > 500 || list.some(email => typeof email !== 'string' || !validEmail(email))) throw new EmailTrackingError(`Provide at most 500 valid ${key} addresses.`)
+        return (list as string[]).map(email => email.trim().toLowerCase())
+    }
+    const to = addresses('to'), cc = addresses('cc')
+    const mailbox = trackingMailbox.toLowerCase()
+    if (!cc.includes(mailbox)) throw new EmailTrackingError('The tracking mailbox must be included in CC.')
+    if (typeof value.sentAt !== 'string' || !/(Z|[+-]\d{2}:\d{2})$/i.test(value.sentAt) || !Number.isFinite(Date.parse(value.sentAt)) || Date.parse(value.sentAt) > now + 5 * 60 * 1000) throw new EmailTrackingError('Provide a valid original sentAt timestamp with a timezone, not a future date.')
+    const from = value.from.trim().toLowerCase()
+    const recipients = [...new Set([...to, ...cc])].filter(email => email !== mailbox && email !== from).sort()
+    const contactedAt = new Date(value.sentAt).toISOString()
+    return { messageId: value.messageId.trim(), from, recipients, contactedAt,
+        fingerprint: createHash('sha256').update(JSON.stringify([from, recipients, contactedAt])).digest('hex') }
+}
